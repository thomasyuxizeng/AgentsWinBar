<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexBarWin.TaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBarWin"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Flush with the taskbar: full taskbar height, square corners, no border.
         Spacing (DIP): 18 side padding, 24 between providers, 10 icon to bars, 8 bar to number, bars close together -->
    <Grid
        x:Name="RootGrid"
        Padding="18,0"
        Background="Transparent"
        PointerPressed="OnPointerPressed">

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Open details" Click="OnOpenDetailsClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Hide taskbar display" Click="OnHideClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED1A;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <ItemsControl
            x:Name="ItemsHost"
            ItemsSource="{x:Bind Items}"
            IsTabStop="False"
            VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="24"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:TaskbarItem">
                    <Grid
                        ColumnSpacing="10"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                              ToolTipService.ToolTip="{x:Bind Name}">
                            <Path Data="{x:Bind Icon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Fill="{x:Bind StatusBrush}" Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                     StrokeThickness="1" Visibility="{x:Bind IncidentVisibility}"
                                     ToolTipService.ToolTip="{x:Bind StatusDescription}"/>
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="0" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="13"/>
                                <RowDefinition Height="13"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto" MinWidth="22"/>
                            </Grid.ColumnDefinitions>

                            <controls:UsageMeter
                                Grid.Row="0"
                                Grid.Column="0"
                                Height="5"
                                VerticalAlignment="Center"
                                Percent="{x:Bind SessionPercent}"
                                TimePercent="{x:Bind SessionTimePercent}"
                                PaceText="{x:Bind SessionPace}"
                                Accent="{x:Bind SessionAccent}"
                                ResetKey="{x:Bind SessionResetKey}"
                                ResetFromPercent="{x:Bind SessionWindow.ResetFromUsedPercent}"
                                ResetDetectedAtUtc="{x:Bind SessionResetStamp}"/>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{x:Bind SessionText}"
                                FontSize="11"
                                TextAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{x:Bind SessionBrush}"/>

                            <controls:UsageMeter
                                Grid.Row="1"
                                Grid.Column="0"
                                Height="5"
                                VerticalAlignment="Center"
                                Percent="{x:Bind WeeklyPercent}"
                                TimePercent="{x:Bind WeeklyTimePercent}"
                                PaceText="{x:Bind WeeklyPace}"
                                Accent="{x:Bind WeeklyAccent}"
                                ResetKey="{x:Bind WeeklyResetKey}"
                                ResetFromPercent="{x:Bind WeeklyWindow.ResetFromUsedPercent}"
                                ResetDetectedAtUtc="{x:Bind WeeklyResetStamp}"/>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{x:Bind WeeklyText}"
                                FontSize="11"
                                TextAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{x:Bind WeeklyBrush}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
