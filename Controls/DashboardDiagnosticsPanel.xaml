<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardDiagnosticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CodexBarWin.Models"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Padding" Value="16,14,16,16"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="60"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="FactTemplate" x:DataType="controls:DashboardFact">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource Meta}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="FactsPanel">
            <StackPanel Spacing="5"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="CardsGrid" ColumnSpacing="12" RowSpacing="12" SizeChanged="OnSizeChanged">

        <Border x:Name="Card0" Style="{StaticResource CardBorder}">
            <StackPanel Spacing="10">
                <TextBlock Text="SYSTEM" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="SystemFactsList" ItemsSource="{x:Bind SystemFacts, Mode=OneWay}" IsTabStop="False"
                              ItemTemplate="{StaticResource FactTemplate}" ItemsPanel="{StaticResource FactsPanel}"/>
            </StackPanel>
        </Border>

        <Border x:Name="Card1" Style="{StaticResource CardBorder}">
            <StackPanel Spacing="10">
                <TextBlock Text="SETTINGS IN EFFECT" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="SettingsFactsList" ItemsSource="{x:Bind SettingsFacts, Mode=OneWay}" IsTabStop="False"
                              ItemTemplate="{StaticResource FactTemplate}" ItemsPanel="{StaticResource FactsPanel}"/>
            </StackPanel>
        </Border>

        <Border x:Name="Card2" Style="{StaticResource CardBorder}">
            <StackPanel Spacing="10">
                <TextBlock Text="USAGE HISTORY STORE" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="HistoryFactsList" ItemsSource="{x:Bind HistoryFacts, Mode=OneWay}" IsTabStop="False"
                              ItemTemplate="{StaticResource FactTemplate}" ItemsPanel="{StaticResource FactsPanel}"/>
            </StackPanel>
        </Border>

        <Border x:Name="Card3" Style="{StaticResource CardBorder}"
                Visibility="{x:Bind views:DashboardFormat.VisCount(CostCacheFacts.Count), Mode=OneWay}">
            <StackPanel Spacing="10">
                <TextBlock Text="COST SCANS" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="CostCacheFactsList" ItemsSource="{x:Bind CostCacheFacts, Mode=OneWay}" IsTabStop="False"
                              ItemTemplate="{StaticResource FactTemplate}" ItemsPanel="{StaticResource FactsPanel}"/>
            </StackPanel>
        </Border>

        <Border x:Name="Card4" Style="{StaticResource CardBorder}">
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource CardTitle}"
                           Text="{x:Bind views:DashboardFormat.RefreshTitle(Data.RecentRefreshes.Count), Mode=OneWay}"/>
                <TextBlock Text="No refreshes recorded yet" Style="{StaticResource Meta}"
                           Visibility="{x:Bind views:DashboardFormat.VisEmpty(Data.RecentRefreshes.Count), Mode=OneWay}"/>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <ItemsControl x:Name="RefreshesList" ItemsSource="{x:Bind Data.RecentRefreshes, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DashboardRefreshEntry">
                                <Grid ColumnSpacing="8" RowSpacing="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <FontIcon Grid.RowSpan="2" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Glyph="{x:Bind views:DashboardFormat.OkGlyph(Success)}"
                                              Foreground="{x:Bind views:DashboardFormat.OkBrush(Success)}"/>
                                    <TextBlock Grid.Column="1" FontSize="12">
                                        <Run Text="{x:Bind views:DashboardFormat.ProviderName(ProviderId)}" FontWeight="SemiBold"/>
                                        <Run Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Run Text="{x:Bind views:DashboardFormat.LocalTime(TimestampUtc)}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Meta}"
                                               Text="{x:Bind views:DashboardFormat.Duration(DurationMs)}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Meta}"
                                               MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind Message}"
                                               ToolTipService.ToolTip="{x:Bind Message}"
                                               Visibility="{x:Bind views:DashboardFormat.VisText(Message)}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border x:Name="Card5" Style="{StaticResource CardBorder}">
            <StackPanel Spacing="10">
                <TextBlock Text="ALERTS THIS SESSION" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="None raised yet" Style="{StaticResource Meta}"
                           Visibility="{x:Bind views:DashboardFormat.VisEmpty(Data.RecentAlerts.Count), Mode=OneWay}"/>
                <ItemsControl x:Name="AlertsList" ItemsSource="{x:Bind Data.RecentAlerts, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DashboardAlertEntry">
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind Title}"/>
                                <TextBlock Style="{StaticResource Meta}" Text="{x:Bind Message}"/>
                                <TextBlock Style="{StaticResource Meta}"
                                           Text="{x:Bind views:DashboardFormat.LocalTime(TimestampUtc)}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
