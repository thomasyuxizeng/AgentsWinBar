<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardUsageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <!-- One provider in the overview: its name and a one-line bar per usage window -->
    <Border Padding="16,12,16,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <PathIcon Data="{x:Bind views:DashboardFormat.Icon(Data.Id), Mode=OneWay}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{x:Bind Data.DisplayName, Mode=OneWay}" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                               Text="{x:Bind views:DashboardFormat.CardNote(Data), Mode=OneWay}"/>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{x:Bind views:DashboardFormat.StatusBrush(Data.ServiceStatus), Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind views:DashboardFormat.StatusTip(Data), Mode=OneWay}"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="RowsHost" Spacing="9"/>
        </StackPanel>
    </Border>
</UserControl>
