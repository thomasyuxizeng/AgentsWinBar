<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardMiniBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <!-- One usage window on a single line: name, bar, percent used, time to reset -->
    <Grid ColumnSpacing="10" Background="Transparent"
          ToolTipService.ToolTip="{x:Bind views:DashboardFormat.MiniTip(Data), Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="74"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Data.Title, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <controls:UsageMeter Grid.Column="1" Height="8" VerticalAlignment="Center"
            Percent="{x:Bind Data.UsedPercent, Mode=OneWay}"
            TimePercent="{x:Bind views:DashboardFormat.Time(Data.ElapsedPercent), Mode=OneWay}"
            Accent="{x:Bind Data.Accent, Mode=OneWay}"/>
        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"
                   Text="{x:Bind views:DashboardFormat.Percent(Data.UsedPercent), Mode=OneWay}"/>
        <TextBlock Grid.Column="3" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind views:DashboardFormat.In(Data.ResetsAtUtc), Mode=OneWay}"/>
    </Grid>
</UserControl>
