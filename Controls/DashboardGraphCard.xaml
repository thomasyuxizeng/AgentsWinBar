<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardGraphCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CodexBarWin.Models"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- One provider's charts: the usage history of each window, then the daily cost -->
    <Border
        Padding="20,16,20,16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <PathIcon Data="{x:Bind views:DashboardFormat.Icon(Data.Id), Mode=OneWay}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Viewbox>
                <TextBlock Text="{x:Bind Data.DisplayName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind Data.Windows, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="16"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DashboardWindow">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind views:DashboardFormat.Used(UsedPercent)}"/>
                            </Grid>
                            <controls:BurndownChart IsCompact="True" PlotHeight="88"
                                                    Series="{x:Bind History}" Accent="{x:Bind Accent}"
                                                    Visibility="{x:Bind views:DashboardFormat.VisSeriesReady(History)}"/>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind views:DashboardFormat.NoSeriesText(History)}"
                                       Visibility="{x:Bind views:DashboardFormat.VisSeriesMissing(History)}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="6" Visibility="{x:Bind views:DashboardFormat.Vis(HasCostChart), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Daily cost" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Last 30 days" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <controls:DailyCostChart PlotHeight="88"
                                         Series="{x:Bind Data.Cost.Daily, Mode=OneWay}"
                                         Currency="{x:Bind Data.Cost.Currency, Mode=OneWay}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Caption}" Text="No graph data yet."
                       Visibility="{x:Bind views:DashboardFormat.Vis(IsEmpty), Mode=OneWay}"/>
        </StackPanel>
    </Border>
</UserControl>
