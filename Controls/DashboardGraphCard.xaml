<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentsWinBar.Controls.DashboardGraphCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentsWinBar.Models"
    xmlns:views="using:AgentsWinBar.Views"
    xmlns:controls="using:AgentsWinBar.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ChartUsedStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ChartMissingStyle" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- One provider's charts: the usage history of each window, then the daily cost -->
    <Border
        Padding="20,16,20,16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <PathIcon x:Name="HeaderIcon"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Viewbox>
                <TextBlock x:Name="HeaderTitle" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel x:Name="WindowsChartsHost" Spacing="16"/>

            <StackPanel x:Name="CostChartSection" Spacing="6" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Daily cost" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Last 30 days" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <controls:DailyCostChart x:Name="CostChart" PlotHeight="88"/>
            </StackPanel>

            <TextBlock x:Name="EmptyMessage" Style="{StaticResource Caption}" Text="No graph data yet."
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
