<UserControl x:Class="CodexBarWin.Controls.DailyCostChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <Canvas x:Name="Plot" Height="90" SizeChanged="OnPlotSizeChanged"/>
        <Grid>
            <TextBlock x:Name="StartLabel" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="EndLabel" HorizontalAlignment="Right" FontSize="10"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </StackPanel>
</UserControl>
