<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardWindowRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <!-- One usage window: title, meter, reset line, pace and a compact burndown chart -->
    <StackPanel Spacing="6">
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind Data.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                        Background="{x:Bind views:DashboardFormat.LimitBrush(Data.UsedPercent), Mode=OneWay}"
                        Visibility="{x:Bind views:DashboardFormat.LimitVis(Data.UsedPercent), Mode=OneWay}">
                    <TextBlock Text="{x:Bind views:DashboardFormat.LimitLabel(Data.UsedPercent), Mode=OneWay}"
                               FontSize="9" FontWeight="Bold" Foreground="#CC000000"/>
                </Border>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                       Text="{x:Bind views:DashboardFormat.Used(Data.UsedPercent), Mode=OneWay}"/>
        </Grid>
        <controls:UsageMeter Height="10"
            Percent="{x:Bind Data.UsedPercent, Mode=OneWay}"
            TimePercent="{x:Bind views:DashboardFormat.Time(Data.ElapsedPercent), Mode=OneWay}"
            Accent="{x:Bind Data.Accent, Mode=OneWay}"
            PaceText="{x:Bind Data.PaceSummary, Mode=OneWay}"/>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Meta}"
                       Text="{x:Bind views:DashboardFormat.ResetLine(Data.ResetText, Data.ResetsAtUtc), Mode=OneWay}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Meta}" TextAlignment="Right"
                       Text="{x:Bind views:DashboardFormat.WindowMeta(Data.WindowMinutes, Data.ElapsedPercent), Mode=OneWay}"/>
        </Grid>
        <TextBlock Style="{StaticResource Meta}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   Text="{x:Bind Data.PaceSummary, Mode=OneWay}"
                   Visibility="{x:Bind views:DashboardFormat.VisText(Data.PaceSummary), Mode=OneWay}"/>
        <TextBlock Style="{StaticResource Meta}"
                   Text="{x:Bind views:DashboardFormat.Changed(Data.LastChangedAtUtc), Mode=OneWay}"
                   Visibility="{x:Bind views:DashboardFormat.VisNotNull(Data.LastChangedAtUtc), Mode=OneWay}"/>
        <controls:BurndownChart IsCompact="True" Margin="0,2,0,0"
                                Series="{x:Bind Data.History, Mode=OneWay}" Accent="{x:Bind Data.Accent, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
