<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardWindowRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- One usage window: title and percent, the meter, one reset caption; pace and window facts on demand -->
    <StackPanel Spacing="4">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind Data.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <Border Style="{StaticResource Badge}"
                        Background="{x:Bind views:DashboardFormat.LimitBrush(Data.UsedPercent), Mode=OneWay}"
                        Visibility="{x:Bind views:DashboardFormat.LimitVis(Data.UsedPercent), Mode=OneWay}">
                    <TextBlock Text="{x:Bind views:DashboardFormat.LimitLabel(Data.UsedPercent), Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{x:Bind views:DashboardFormat.LimitForeground(Data.UsedPercent), Mode=OneWay}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Background="{x:Bind views:DashboardFormat.EarlyBrush()}"
                        Visibility="{x:Bind views:DashboardFormat.EarlyVis(Data), Mode=OneWay}">
                    <TextBlock Text="{x:Bind views:DashboardFormat.EarlyChip(Data), Mode=OneWay}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#DD000000"/>
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                       Text="{x:Bind views:DashboardFormat.Used(Data.UsedPercent), Mode=OneWay}"/>
        </Grid>
        <controls:UsageMeter x:Name="Meter" Height="8" Margin="0,2,0,0"
            Percent="{x:Bind Data.UsedPercent, Mode=OneWay}"
            TimePercent="{x:Bind views:DashboardFormat.Time(Data.ElapsedPercent), Mode=OneWay}"
            Accent="{x:Bind Data.Accent, Mode=OneWay}"
            PaceText="{x:Bind Data.PaceSummary, Mode=OneWay}"
            ResetFromPercent="{x:Bind Data.ResetFromUsedPercent, Mode=OneWay}"
            ResetDetectedAtUtc="{x:Bind Data.ResetDetectedAtUtc, Mode=OneWay}"/>

        <!-- One reset caption; in a group sharing a reset only the last row shows it -->
        <TextBlock Style="{StaticResource Caption}"
                   Text="{x:Bind views:DashboardFormat.ResetCaption(Data, GroupSize), Mode=OneWay}"
                   Visibility="{x:Bind views:DashboardFormat.Vis(ShowReset), Mode=OneWay}"/>
        <TextBlock Style="{StaticResource Caption}"
                   Text="{x:Bind views:DashboardFormat.EarlyDetail(Data), Mode=OneWay}"
                   Visibility="{x:Bind views:DashboardFormat.VisEarlyDetail(Data), Mode=OneWay}"/>
        <!-- Up front only when the window is on course to run out -->
        <StackPanel Orientation="Horizontal" Spacing="6"
                    Visibility="{x:Bind views:DashboardFormat.VisPaceAlert(Data), Mode=OneWay}">
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Text="{x:Bind Data.PaceSummary, Mode=OneWay}"/>
        </StackPanel>

        <!-- Details on demand -->
        <StackPanel Spacing="4" Margin="0,2,0,0" Visibility="{x:Bind views:DashboardFormat.Vis(ShowDetails), Mode=OneWay}">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="{x:Bind Data.PaceSummary, Mode=OneWay}"
                       Visibility="{x:Bind views:DashboardFormat.VisPaceDetail(Data, ShowDetails), Mode=OneWay}"/>
            <TextBlock Style="{StaticResource Caption}"
                       Text="{x:Bind views:DashboardFormat.WindowDetail(Data), Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
