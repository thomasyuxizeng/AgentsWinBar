<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexBarWin.Controls.DashboardProviderPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CodexBarWin.Models"
    xmlns:views="using:CodexBarWin.Views"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="60"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="18,16,18,18"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel Spacing="14">

            <!-- Header: logo, name, plan, service status -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                    <PathIcon Data="{x:Bind views:DashboardFormat.Icon(Data.Id), Mode=OneWay}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Data.DisplayName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource Chip}" VerticalAlignment="Center"
                                Visibility="{x:Bind views:DashboardFormat.VisText(Data.Plan), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Data.Plan, Mode=OneWay}" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Background="#33FFB900"
                                Visibility="{x:Bind views:DashboardFormat.Vis(Data.IsStale), Mode=OneWay}">
                            <TextBlock Text="Stale data" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Meta}"
                               Text="{x:Bind views:DashboardFormat.Freshness(Data), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{x:Bind views:DashboardFormat.StatusBrush(Data.ServiceStatus), Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind views:DashboardFormat.StatusText(Data.ServiceStatus), Mode=OneWay}"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="220"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Meta}" HorizontalAlignment="Right"
                               Text="{x:Bind views:DashboardFormat.SourceText(Data.Source), Mode=OneWay}"
                               ToolTipService.ToolTip="Where these numbers came from"/>
                </StackPanel>
            </Grid>

            <!-- Incident banner -->
            <Border Padding="12,10" CornerRadius="6" BorderThickness="1.5"
                    BorderBrush="{x:Bind views:DashboardFormat.StatusBrush(Data.ServiceStatus), Mode=OneWay}"
                    Visibility="{x:Bind views:DashboardFormat.StatusBanner(Data.ServiceStatus), Mode=OneWay}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Provider service status" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{x:Bind views:DashboardFormat.StatusText(Data.ServiceStatus), Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="12"/>
                    <HyperlinkButton Content="Open status page" Padding="0" FontSize="12"
                                     NavigateUri="{x:Bind views:DashboardFormat.StatusUri(Data.ServiceStatus), Mode=OneWay}"
                                     Visibility="{x:Bind views:DashboardFormat.StatusLink(Data.ServiceStatus), Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <!-- Fetch error -->
            <Border Padding="12,10" CornerRadius="6" Background="#22E81123" BorderBrush="#66E81123" BorderThickness="1"
                    Visibility="{x:Bind views:DashboardFormat.VisText(Data.Error), Mode=OneWay}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Last fetch failed" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{x:Bind Data.Error, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>

            <!-- Usage windows -->
            <StackPanel Spacing="10"
                        Visibility="{x:Bind views:DashboardFormat.VisCount(WindowCount), Mode=OneWay}">
                <TextBlock Text="USAGE WINDOWS" Style="{StaticResource SectionCaption}"/>
                <ItemsControl ItemsSource="{x:Bind Data.Windows, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="18"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DashboardWindow">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                Background="{x:Bind views:DashboardFormat.LimitBrush(UsedPercent)}"
                                                Visibility="{x:Bind views:DashboardFormat.LimitVis(UsedPercent)}">
                                            <TextBlock Text="{x:Bind views:DashboardFormat.LimitLabel(UsedPercent)}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#CC000000"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                                               Text="{x:Bind views:DashboardFormat.Used(UsedPercent)}"/>
                                </Grid>
                                <controls:UsageMeter Height="10"
                                    Percent="{x:Bind UsedPercent}"
                                    TimePercent="{x:Bind views:DashboardFormat.Time(ElapsedPercent)}"
                                    Accent="{x:Bind Accent}"
                                    PaceText="{x:Bind PaceSummary}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Meta}"
                                               Text="{x:Bind views:DashboardFormat.ResetLine(ResetText, ResetsAtUtc)}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Meta}" TextAlignment="Right"
                                               Text="{x:Bind views:DashboardFormat.WindowMeta(WindowMinutes, ElapsedPercent)}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Meta}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Text="{x:Bind PaceSummary}"
                                           Visibility="{x:Bind views:DashboardFormat.VisText(PaceSummary)}"/>
                                <TextBlock Style="{StaticResource Meta}"
                                           Text="{x:Bind views:DashboardFormat.Changed(LastChangedAtUtc)}"
                                           Visibility="{x:Bind views:DashboardFormat.VisNotNull(LastChangedAtUtc)}"/>
                                <controls:BurndownChart IsCompact="True" Margin="0,2,0,0"
                                                        Series="{x:Bind History}" Accent="{x:Bind Accent}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Credits -->
            <StackPanel Spacing="4" Visibility="{x:Bind views:DashboardFormat.VisNotNull(Data.Credits), Mode=OneWay}">
                <TextBlock Text="CREDITS" Style="{StaticResource SectionCaption}"/>
                <TextBlock x:Name="CreditsText" FontSize="13"/>
            </StackPanel>

            <!-- Cost and tokens -->
            <StackPanel Spacing="12" x:Name="CostSection"
                        Visibility="{x:Bind views:DashboardFormat.VisNotNull(Data.Cost), Mode=OneWay}">
                <TextBlock Text="COST AND TOKENS · ESTIMATED FROM LOCAL LOGS" Style="{StaticResource SectionCaption}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Today" Style="{StaticResource Meta}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold"
                                   Text="{x:Bind views:DashboardFormat.Money(Data.Cost.TodayCost, Data.Cost.Currency), Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Meta}"
                                   Text="{x:Bind views:DashboardFormat.Tokens(Data.Cost.TodayTokens), Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="Last 30 days" Style="{StaticResource Meta}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold"
                                   Text="{x:Bind views:DashboardFormat.Money(Data.Cost.Last30DaysCost, Data.Cost.Currency), Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Meta}"
                                   Text="{x:Bind views:DashboardFormat.Tokens(Data.Cost.Last30DaysTokens), Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <controls:DailyCostChart PlotHeight="76"
                                         Series="{x:Bind Data.Cost.Daily, Mode=OneWay}"
                                         Currency="{x:Bind Data.Cost.Currency, Mode=OneWay}"/>

                <TextBlock Text="Token mix (30 days)" Style="{StaticResource Meta}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{x:Bind TokenRows, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="5"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:DashboardBarRow">
                            <Grid ColumnSpacing="8" RowSpacing="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind Label}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{x:Bind Percent}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Top models (30 days)" Style="{StaticResource Meta}" FontWeight="SemiBold"
                           Visibility="{x:Bind views:DashboardFormat.VisCount(ModelRows.Count), Mode=OneWay}"/>
                <ItemsControl ItemsSource="{x:Bind ModelRows, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="5"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:DashboardBarRow">
                            <Grid ColumnSpacing="8" RowSpacing="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{x:Bind Percent}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{x:Bind CostFacts, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="3"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:DashboardFact">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource Meta}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- History footer -->
            <TextBlock Style="{StaticResource Meta}" x:Name="HistoryText"/>
        </StackPanel>
    </Border>
</UserControl>
