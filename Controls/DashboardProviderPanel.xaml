<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentsWinBar.Controls.DashboardProviderPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AgentsWinBar.Models"
    xmlns:views="using:AgentsWinBar.Views"
    xmlns:controls="using:AgentsWinBar.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <!-- Small caps are kept for section headers only -->
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="60"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Hero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="32"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="20,16,20,16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel Spacing="16">

            <!-- Header: identity, then one freshness line; on the right one status indicator and the details toggle -->
            <Grid ColumnSpacing="12" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Viewbox Grid.RowSpan="2" Width="24" Height="24" VerticalAlignment="Center">
                    <PathIcon x:Name="ProviderIcon"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Viewbox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Data.DisplayName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center"
                            Visibility="{x:Bind views:DashboardFormat.VisText(Data.Plan), Mode=OneWay}">
                        <TextBlock Text="{x:Bind Data.Plan, Mode=OneWay}" FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Freshness and source, said once; amber with a warning glyph when the numbers are last-known -->
                <Grid x:Name="FreshnessGrid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Background="Transparent">
                    <TextBlock x:Name="FreshnessFreshText" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="{x:Bind views:DashboardFormat.FreshnessLine(Data), Mode=OneWay}"
                               Visibility="{x:Bind views:DashboardFormat.VisFresh(Data), Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind views:DashboardFormat.VisStale(Data), Mode=OneWay}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="FreshnessStaleText" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind views:DashboardFormat.FreshnessLine(Data), Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <!-- One service status indicator: dot and description, a link to the status page when there is one -->
                <StackPanel x:Name="StatusHeaderPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{x:Bind views:DashboardFormat.VisStatus(Data.ServiceStatus), Mode=OneWay}">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"/>
                    <HyperlinkButton Padding="0" FontSize="12" MaxWidth="240"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                     ToolTipService.ToolTip="Open the status page"
                                     NavigateUri="{x:Bind views:DashboardFormat.StatusUri(Data.ServiceStatus), Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind views:DashboardFormat.StatusText(Data.ServiceStatus), Mode=OneWay}"
                                     Visibility="{x:Bind views:DashboardFormat.VisStatusLink(Data.ServiceStatus), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind views:DashboardFormat.StatusText(Data.ServiceStatus), Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"/>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="10" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </HyperlinkButton>
                    <TextBlock FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Text="{x:Bind views:DashboardFormat.StatusText(Data.ServiceStatus), Mode=OneWay}"
                               Visibility="{x:Bind views:DashboardFormat.VisStatusPlain(Data.ServiceStatus), Mode=OneWay}"/>
                </StackPanel>
            </Grid>

            <!-- Signed out: the provider's CLI needs a new login. Replaces the generic fetch-error banner below; the numbers further down are last-known -->
            <InfoBar x:Name="SignedOutBar" IsOpen="{x:Bind views:DashboardFormat.IsSignedOut(Data), Mode=OneWay}" IsClosable="False"
                     Visibility="{x:Bind views:DashboardFormat.VisSignedOut(Data), Mode=OneWay}"
                     Severity="Error" Title="Signed out" AutomationProperties.Name="Signed out">
                <!-- InfoBar's compact action size (24 high) keeps the title row's height; the hint starts below the button -->
                <InfoBar.ActionButton>
                    <Button x:Name="SignInButton" Content="Sign in" Click="OnSignInClicked" MinHeight="24" Padding="8,0,8,1"
                            AutomationProperties.Name="{x:Bind views:DashboardFormat.SignInButtonName(Data), Mode=OneWay}"/>
                </InfoBar.ActionButton>
                <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="{x:Bind views:DashboardFormat.SignedOutHint(Data), Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
            </InfoBar>

            <!-- Incident detail (only when the status page has more to say than the header's description) -->
            <InfoBar x:Name="IncidentBar" IsOpen="{x:Bind views:DashboardFormat.HasIncident(Data), Mode=OneWay}" IsClosable="False"
                     Visibility="{x:Bind views:DashboardFormat.VisIncident(Data), Mode=OneWay}"
                     Severity="{x:Bind views:DashboardFormat.IncidentSeverity(Data.ServiceStatus), Mode=OneWay}"
                     Title="{x:Bind views:DashboardFormat.IncidentHeading(Data), Mode=OneWay}">
                <StackPanel Spacing="4" Margin="0,-8,0,12">
                    <TextBlock Text="{x:Bind views:DashboardFormat.IncidentBody(Data), Mode=OneWay}"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="12"
                               ToolTipService.ToolTip="{x:Bind views:DashboardFormat.IncidentBody(Data), Mode=OneWay}"
                               Visibility="{x:Bind views:DashboardFormat.VisIncidentBody(Data), Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="IncidentAgeText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Text="{x:Bind views:DashboardFormat.IncidentAge(Data), Mode=OneWay}"
                                   Visibility="{x:Bind views:DashboardFormat.VisIncidentAge(Data), Mode=OneWay}"/>
                        <HyperlinkButton Content="Open status page" Padding="0" FontSize="12"
                                         NavigateUri="{x:Bind views:DashboardFormat.StatusUri(Data.ServiceStatus), Mode=OneWay}"
                                         Visibility="{x:Bind views:DashboardFormat.StatusLink(Data.ServiceStatus), Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </InfoBar>

            <!-- Fetch error -->
            <InfoBar x:Name="FetchErrorBar" IsOpen="{x:Bind views:DashboardFormat.HasFetchError(Data), Mode=OneWay}" IsClosable="False"
                     Visibility="{x:Bind views:DashboardFormat.VisFetchError(Data), Mode=OneWay}"
                     Severity="Error" Title="Last fetch failed">
                <StackPanel Spacing="4" Margin="0,-8,0,12">
                    <TextBlock Text="{x:Bind Data.Error, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="LastKnownDataText" Style="{StaticResource Caption}" Text="{x:Bind views:DashboardFormat.LastKnownData(Data), Mode=OneWay}"
                               Visibility="{x:Bind views:DashboardFormat.VisLastKnownData(Data), Mode=OneWay}"/>
                </StackPanel>
            </InfoBar>

            <!-- Usage windows: one list, or two side by side in a wide panel (Gemini models | External) -->
            <Grid x:Name="WindowsHost" ColumnSpacing="28" SizeChanged="OnWindowsHostSizeChanged"
                  Opacity="{x:Bind views:DashboardFormat.StaleNumbersOpacity(Data), Mode=OneWay}"
                  Visibility="{x:Bind views:DashboardFormat.VisCount(WindowCount), Mode=OneWay}"/>

            <!-- CLI credits -->
            <TextBlock x:Name="CreditsText" FontSize="13" TextWrapping="Wrap"
                       Visibility="{x:Bind views:DashboardFormat.VisNotNull(Data.Credits), Mode=OneWay}"/>

            <!-- Claude Platform API credits (read from the Anthropic Cost API; unrelated to the CLI credits above) -->
            <StackPanel Spacing="8" x:Name="ApiCreditsSection"
                        Visibility="{x:Bind views:DashboardFormat.VisApiSection(Data.ApiCredits, ShowDetails), Mode=OneWay}">
                <Border Style="{StaticResource Divider}" Margin="0,0,0,8"/>
                <Grid>
                    <TextBlock Text="API CREDITS · THIS BILLING CYCLE" Style="{StaticResource SectionCaption}" VerticalAlignment="Center"/>
                    <HyperlinkButton HorizontalAlignment="Right" Padding="0" FontSize="12"
                                     AutomationProperties.Name="Open billing page"
                                     ToolTipService.ToolTip="Open the Claude Platform billing page"
                                     NavigateUri="{x:Bind views:DashboardFormat.ApiBillingUri()}"
                                     Visibility="{x:Bind views:DashboardFormat.VisApiOk(Data.ApiCredits), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Billing"/>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="11"/>
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>

                <!-- Ok: spent of the pool, what is left, the bar with the cycle's elapsed-time tick, who used it -->
                <StackPanel Spacing="8" Visibility="{x:Bind views:DashboardFormat.VisApiOk(Data.ApiCredits), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind views:DashboardFormat.ApiUpdatedTip(Data.ApiCredits), Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource Hero}"
                                       Text="{x:Bind views:DashboardFormat.ApiSpent(Data.ApiCredits), Mode=OneWay}"/>
                            <TextBlock FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind views:DashboardFormat.ApiOf(Data.ApiCredits), Mode=OneWay}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                   Text="{x:Bind views:DashboardFormat.ApiLeft(Data.ApiCredits), Mode=OneWay}"
                                   Visibility="{x:Bind views:DashboardFormat.VisApiLeftOk(Data.ApiCredits), Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind views:DashboardFormat.ApiLeft(Data.ApiCredits), Mode=OneWay}"
                                   Visibility="{x:Bind views:DashboardFormat.VisApiLeftOver(Data.ApiCredits), Mode=OneWay}"/>
                    </Grid>

                    <controls:UsageMeter x:Name="ApiMeter" Height="8"
                                         Percent="{x:Bind Data.ApiCredits.PercentUsed, Mode=OneWay}"
                                         TimePercent="{x:Bind views:DashboardFormat.ApiTime(Data.ApiCredits), Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind views:DashboardFormat.ApiAutomationName(Data.ApiCredits), Mode=OneWay}"/>
                    <TextBlock x:Name="ApiCaptionText" Style="{StaticResource Caption}"
                               Text="{x:Bind views:DashboardFormat.ApiCaption(Data.ApiCredits), Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind views:DashboardFormat.VisApiStale(Data.ApiCredits), Mode=OneWay}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="ApiStaleTextBlock" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind views:DashboardFormat.ApiStaleText(Data.ApiCredits), Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Who used the shared pool: one line per member (You first); bars are shares of the pool -->
                    <StackPanel Spacing="6" Margin="0,4,0,0"
                                Visibility="{x:Bind views:DashboardFormat.VisApiBreakdown(Data.ApiCredits), Mode=OneWay}">
                        <TextBlock Text="Used by" Style="{StaticResource SubHeading}"/>
                        <ItemsControl x:Name="ApiUseList" ItemsSource="{x:Bind ApiUseRows, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:DashboardApiUseRow">
                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="64"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Visibility="{x:Bind views:DashboardFormat.VisNot(IsOthers)}"/>
                                        <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind views:DashboardFormat.Vis(IsOthers)}"/>
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind Percent}" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind AutomationName}"
                                                     Visibility="{x:Bind views:DashboardFormat.Vis(IsYou)}"/>
                                        <!-- A neutral fill that differs from the track (ControlStrong... is the track's own colour) -->
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind Percent}" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind AutomationName}"
                                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                     Visibility="{x:Bind views:DashboardFormat.VisNot(IsYou)}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Amount}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Share}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind views:DashboardFormat.VisApiUnattributed(Data.ApiCredits), Mode=OneWay}"
                              ToolTipService.ToolTip="Non-token charges (for example web search), console playground use or deleted keys">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="56"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Other / not attributable" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="13" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind views:DashboardFormat.ApiUnattributed(Data.ApiCredits), Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Rejected / Unavailable: the reason; no key: how to add one (in the details). Both lead to the Settings card. -->
                <TextBlock Style="{StaticResource Caption}"
                           Text="{x:Bind Data.ApiCredits.Message, Mode=OneWay}"
                           Visibility="{x:Bind views:DashboardFormat.VisApiMessage(Data.ApiCredits), Mode=OneWay}"/>
                <TextBlock Style="{StaticResource Caption}"
                           Text="{x:Bind views:DashboardFormat.ApiNoKeyText(Data.ApiCredits), Mode=OneWay}"
                           Visibility="{x:Bind views:DashboardFormat.VisApiNoKey(Data.ApiCredits), Mode=OneWay}"/>
                <StackPanel Orientation="Horizontal" Spacing="12"
                            Visibility="{x:Bind views:DashboardFormat.VisApiKeyLink(Data.ApiCredits), Mode=OneWay}">
                    <Button x:Name="ApiOpenSettingsButton" Content="Open Settings" FontSize="12" Padding="10,4"
                            Click="OnOpenApiSettingsClicked" VerticalAlignment="Center"
                            AutomationProperties.Name="Open Settings to set up the Anthropic Admin key"
                            ToolTipService.ToolTip="Set up or replace the Admin key in Settings"/>
                    <HyperlinkButton Content="Create an Admin key" Padding="0" FontSize="12" VerticalAlignment="Center"
                                     AutomationProperties.Name="Create an Admin key"
                                     NavigateUri="{x:Bind views:DashboardFormat.ApiAdminKeysUri()}"/>
                </StackPanel>
            </StackPanel>

            <!-- Gemini API spend this month (estimated from the local spend log; gemini provider only, hidden without a log) -->
            <StackPanel Spacing="8" x:Name="GeminiApiSection"
                        Visibility="{x:Bind views:DashboardFormat.VisGeminiSection(Data.GeminiApi), Mode=OneWay}">
                <Border Style="{StaticResource Divider}" Margin="0,0,0,8"/>
                <TextBlock Text="GEMINI API · THIS MONTH" Style="{StaticResource SectionCaption}"/>

                <!-- Ok: the month's total and call count, the routes it went through, then the models; no budget, so no bar for the total -->
                <StackPanel Spacing="8" Visibility="{x:Bind views:DashboardFormat.VisGeminiOk(Data.GeminiApi), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent"
                                AutomationProperties.Name="{x:Bind views:DashboardFormat.GeminiAutomationName(Data.GeminiApi), Mode=OneWay}"
                                ToolTipService.ToolTip="List prices applied to the token counts in the local spend log, with cached input at the cache rate. Credits and prepaid balances are not subtracted.">
                        <TextBlock Style="{StaticResource Hero}"
                                   Text="{x:Bind views:DashboardFormat.GeminiTotal(Data.GeminiApi), Mode=OneWay}"/>
                        <TextBlock FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind views:DashboardFormat.GeminiCalls(Data.GeminiApi), Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Routes, named by route rather than by who pays; each only when it has spend -->
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12" Visibility="{x:Bind views:DashboardFormat.VisGeminiAiStudio(Data.GeminiApi), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AI Studio key" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="13" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind views:DashboardFormat.GeminiAiStudio(Data.GeminiApi), Mode=OneWay}"/>
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind views:DashboardFormat.VisGeminiVertex(Data.GeminiApi), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vertex" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="13" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind views:DashboardFormat.GeminiVertex(Data.GeminiApi), Mode=OneWay}"/>
                        </Grid>
                        <Grid ColumnSpacing="12" Background="Transparent"
                              Visibility="{x:Bind views:DashboardFormat.VisGeminiUnrecorded(Data.GeminiApi), Mode=OneWay}"
                              ToolTipService.ToolTip="Gemini CLI jobs do not record which route they used">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Route not recorded" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="13" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind views:DashboardFormat.GeminiUnrecorded(Data.GeminiApi), Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- By model: bars are shares of the month's total -->
                    <StackPanel Spacing="6" Margin="0,4,0,0"
                                Visibility="{x:Bind views:DashboardFormat.VisCount(GeminiUseRowTotal), Mode=OneWay}">
                        <TextBlock Text="By model" Style="{StaticResource SubHeading}"/>
                        <ItemsControl x:Name="GeminiUseList" ItemsSource="{x:Bind GeminiUseRows, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:DashboardApiUseRow">
                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="64"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextWrapping="WrapWholeWords" MaxLines="2"
                                                   ToolTipService.ToolTip="{x:Bind Label}"
                                                   Visibility="{x:Bind views:DashboardFormat.VisNot(IsOthers)}"/>
                                        <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextWrapping="WrapWholeWords" MaxLines="2"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind views:DashboardFormat.Vis(IsOthers)}"/>
                                        <!-- A neutral fill that differs from the track (ControlStrong... is the track's own colour) -->
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind Percent}" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind AutomationName}"
                                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Amount}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Share}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock x:Name="GeminiCaptionText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{x:Bind views:DashboardFormat.GeminiCaption(Data.GeminiApi), Mode=OneWay}"/>
                </StackPanel>

                <!-- Unavailable: the reason -->
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="{x:Bind views:DashboardFormat.GeminiMessage(Data.GeminiApi), Mode=OneWay}"
                           Visibility="{x:Bind views:DashboardFormat.VisGeminiUnavailable(Data.GeminiApi), Mode=OneWay}"/>
            </StackPanel>

            <!-- Cost and tokens: totals and the daily chart; breakdowns in the details -->
            <StackPanel Spacing="8" x:Name="CostSection"
                        Visibility="{x:Bind views:DashboardFormat.VisNotNull(Data.Cost), Mode=OneWay}">
                <Border Style="{StaticResource Divider}" Margin="0,0,0,8"/>
                <TextBlock Text="ESTIMATED COST · LOCAL LOGS" Style="{StaticResource SectionCaption}"
                           ToolTipService.ToolTip="List-price estimate from local session logs, not your bill"/>
                <StackPanel Orientation="Horizontal" Spacing="6"
                            Visibility="{x:Bind views:DashboardFormat.VisCostStale(Data.Cost), Mode=OneWay}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock x:Name="CostStaleText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Text="{x:Bind views:DashboardFormat.CostStale(Data.Cost), Mode=OneWay}"/>
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Today" Style="{StaticResource Caption}"/>
                        <TextBlock Style="{StaticResource Hero}"
                                   Text="{x:Bind views:DashboardFormat.Money(Data.Cost.TodayCost, Data.Cost.Currency), Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{x:Bind views:DashboardFormat.TokenCount(Data.Cost.TodayTokens), Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Last 30 days" Style="{StaticResource Caption}"/>
                        <TextBlock Style="{StaticResource Hero}"
                                   Text="{x:Bind views:DashboardFormat.Money(Data.Cost.Last30DaysCost, Data.Cost.Currency), Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{x:Bind views:DashboardFormat.TokenCount(Data.Cost.Last30DaysTokens), Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <!-- Details: token mix, top models and how the numbers were made -->
                <StackPanel Spacing="8" Margin="0,8,0,0" Visibility="{x:Bind views:DashboardFormat.Vis(ShowDetails), Mode=OneWay}">
                    <TextBlock Text="Token mix (30 days)" Style="{StaticResource SubHeading}"/>
                    <ItemsControl x:Name="TokenMixList" ItemsSource="{x:Bind TokenRows, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:DashboardBarRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="80"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind Percent}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Value}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Top models (30 days)" Style="{StaticResource SubHeading}" Margin="0,4,0,0"
                               Visibility="{x:Bind views:DashboardFormat.VisCount(ModelRows.Count), Mode=OneWay}"/>
                    <ItemsControl x:Name="TopModelsList" ItemsSource="{x:Bind ModelRows, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:DashboardBarRow">
                                <Grid ColumnSpacing="8" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{x:Bind Percent}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="CostFactsList" ItemsSource="{x:Bind CostFacts, Mode=OneWay}" IsTabStop="False" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:DashboardFact">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Footer: the details toggle, and in the details how much usage history this provider has -->
            <Grid ColumnSpacing="12" Margin="0,-4,0,-4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DetailsButton" Padding="8,4" Margin="-8,0,0,0" Background="Transparent" BorderThickness="0"
                        Click="OnDetailsClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DetailsText" Text="Show details" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <FontIcon x:Name="DetailsGlyph" FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" x:Name="HistoryText" VerticalAlignment="Center"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Visibility="{x:Bind views:DashboardFormat.Vis(ShowDetails), Mode=OneWay}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
