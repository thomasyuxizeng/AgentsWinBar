<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <Compile Include="..\..\Services\Native\Cost\*.cs" Link="Linked\NativeCost\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Services\Native\Cost\Pricing\*.json" LogicalName="CodexBarWin.Pricing.%(Filename)%(Extension)" Link="Linked\Pricing\%(Filename)%(Extension)" />
    <Compile Include="..\..\Models\CostData.cs;..\..\Models\CostLedgerModels.cs;..\..\Models\ProviderConfig.cs;..\..\Models\UsageData.cs" Link="Linked\%(Filename)%(Extension)" />
    <Compile Include="..\..\Helpers\DashboardValues.cs;..\..\Helpers\ResetTimeFormatter.cs;..\..\Helpers\PaceCalculator.cs" Link="Linked\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
