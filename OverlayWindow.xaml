<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexBarWin.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBarWin"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="12,8"
        Background="Transparent"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OnPointerPressed">

        <Grid.ContextFlyout>
            <MenuFlyout x:Name="OverlayMenu">
                <MenuFlyoutItem Text="Open details" Click="OnOpenDetailsClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Hide overlay" Click="OnHideOverlayClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED1A;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <ItemsControl x:Name="RowsControl" ItemsSource="{x:Bind Rows}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:OverlayRow" x:DefaultBindMode="OneWay">
                    <!-- No column spacing: each bar column carries its own 8 DIP lead-in (via the bar's margin) and each
                         number column carries its own short lead-in (OverlayWindow.NumberGapDip), so the gap between a
                         bar and its number can be tighter than the gap to the next element. -->
                    <Grid Height="{x:Bind RowHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="{x:Bind SessionNumberColumn}"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="{x:Bind WeeklyNumberColumn}"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                              ToolTipService.ToolTip="{x:Bind Name}">
                            <Path Data="{x:Bind Icon}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Fill="{x:Bind StatusBrush}" Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                     StrokeThickness="1" Visibility="{x:Bind IncidentVisibility}"
                                     ToolTipService.ToolTip="{x:Bind StatusDescription}"/>
                        </Grid>

                        <controls:UsageMeter
                            Grid.Column="1"
                            Height="5"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Percent="{x:Bind SessionPercent}"
                            TimePercent="{x:Bind SessionTimePercent}"
                            PaceText="{x:Bind SessionPace}"
                            Accent="{x:Bind SessionAccent}"
                            ResetHost="{x:Bind ResetHost}"
                            ResetKey="{x:Bind SessionResetKey}"
                            ResetFromPercent="{x:Bind SessionWindow.ResetFromUsedPercent}"
                            ResetDetectedAtUtc="{x:Bind SessionResetStamp}"/>
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind SessionText}"
                            FontSize="11"
                            TextAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <controls:UsageMeter
                            Grid.Column="3"
                            Height="5"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Percent="{x:Bind WeeklyPercent}"
                            TimePercent="{x:Bind WeeklyTimePercent}"
                            PaceText="{x:Bind WeeklyPace}"
                            Accent="{x:Bind WeeklyAccent}"
                            ResetHost="{x:Bind ResetHost}"
                            ResetKey="{x:Bind WeeklyResetKey}"
                            ResetFromPercent="{x:Bind WeeklyWindow.ResetFromUsedPercent}"
                            ResetDetectedAtUtc="{x:Bind WeeklyResetStamp}"/>
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind WeeklyText}"
                            FontSize="11"
                            TextAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
