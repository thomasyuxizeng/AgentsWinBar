<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexBarWin.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBarWin"
    xmlns:controls="using:CodexBarWin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="12,8"
        Background="Transparent"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OnPointerPressed">

        <Grid.ContextFlyout>
            <MenuFlyout x:Name="OverlayMenu">
                <MenuFlyoutItem Text="Open details" Click="OnOpenDetailsClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Hide overlay" Click="OnHideOverlayClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED1A;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <ItemsControl x:Name="RowsControl" ItemsSource="{x:Bind Rows}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:OverlayRow">
                    <Grid Height="{x:Bind RowHeight}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <Path
                            Grid.Column="0"
                            Data="{x:Bind Icon}"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            ToolTipService.ToolTip="{x:Bind Name}"/>

                        <controls:UsageMeter
                            Grid.Column="1"
                            Height="5"
                            VerticalAlignment="Center"
                            Percent="{x:Bind SessionPercent}"/>
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind SessionText}"
                            FontSize="11"
                            TextAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <controls:UsageMeter
                            Grid.Column="3"
                            Height="5"
                            VerticalAlignment="Center"
                            Percent="{x:Bind WeeklyPercent}"/>
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind WeeklyText}"
                            FontSize="11"
                            TextAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
