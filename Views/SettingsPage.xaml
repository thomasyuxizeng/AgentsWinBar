<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AgentsWinBar.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentsWinBar.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" Padding="20,8,20,20">
            <StackPanel Spacing="4" MaxWidth="600">

                <InfoBar x:Name="SaveErrorBar" IsOpen="False" Severity="Error"
                         Title="Couldn't save settings"
                         Message="Check that the settings folder is writable, then try again."/>

                <!-- Appearance Section -->
                <TextBlock
                    Text="Appearance"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,12,0,8"/>

                <!-- Theme Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- The dropdown sits under its label instead of beside it: the window is only ~350 DIP wide on a 150% display, so a
                         side-by-side layout either clipped "Use system setting" (fixed 150) or squeezed the label to nothing (wide). -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="App theme" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Select which app theme to display"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Row="1"
                        x:Name="ThemeComboBox" AutomationProperties.Name="App theme"
                        MinWidth="220"
                        HorizontalAlignment="Left">
                        <ComboBoxItem Content="Use system setting" Tag="0"/>
                        <ComboBoxItem Content="Light" Tag="1"/>
                        <ComboBoxItem Content="Dark" Tag="2"/>
                    </ComboBox>
                </Grid>

                <!-- Reset animation Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Reset animation" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            x:Name="ResetAnimationDescriptionText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Row="1"
                        x:Name="ResetAnimationComboBox" AutomationProperties.Name="Reset animation"
                        MinWidth="220"
                        HorizontalAlignment="Left"/>
                </Grid>

                <!-- Providers Section -->
                <TextBlock
                    Text="Providers"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,20,0,8"/>

                <!-- Providers Card -->
                <Grid
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Text="Choose which providers to show, whether the dashboard charts them, and their display order"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,12"/>

                        <ItemsControl x:Name="ProvidersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Provider Icon -->
                                        <Viewbox
                                            Grid.Column="0"
                                            Grid.RowSpan="2"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                            <PathIcon Data="{Binding IconPath}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Viewbox>

                                        <!-- Provider Checkbox -->
                                        <CheckBox
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Content="{Binding DisplayName}"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            MinWidth="100"/>

                                        <!-- Spacer -->
                                        <Grid Grid.Column="2"/>

                                        <!-- Graphs on the dashboard -->
                                        <CheckBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Content="Show graphs"
                                            FontSize="12"
                                            IsChecked="{Binding ShowGraphs, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Show this provider's charts below the dashboard panels"/>

                                        <!-- Move Up Button -->
                                        <Button
                                            Grid.RowSpan="2"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Move up"
                                            Padding="8,6"
                                            Margin="4,0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="Move provider up" Click="OnMoveUpClicked">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" FontSize="12"/>
                                        </Button>

                                        <!-- Move Down Button -->
                                        <Button
                                            Grid.RowSpan="2"
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Move down"
                                            Padding="8,6"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="Move provider down" Click="OnMoveDownClicked">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Behavior Section -->
                <Grid Padding="16,12" Margin="0,8,0,0" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Show cost and token totals" TextWrapping="Wrap"/>
                        <TextBlock Text="Estimates from local session logs, scanned while the flyout or dashboard is open"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="CostTotalsToggle" AutomationProperties.Name="Show cost and token totals" OnContent="" OffContent=""
                                  MinWidth="0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Anthropic API credits: the Admin key (applied at once, never through Save) and the budget (saved with Save).
                     Controls are stacked, as the window is only ~350 DIP wide on a 150% display. -->
                <Grid x:Name="ApiCreditsCard" Padding="16,12" Margin="0,8,0,0" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Anthropic API credits" TextWrapping="Wrap"/>
                        <TextBlock Text="Shows your organization's API spend against a monthly budget on the dashboard, and who used it."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Needs an Anthropic Admin key. It stays in your Windows user environment (ANTHROPIC_ADMIN_KEY) and is used only to read, never to change anything."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Status: not set up / checking / connected / rejected / could not be checked -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="ApiKeyProgress" IsActive="False" Visibility="Collapsed"
                                          Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="ApiKeyStatusText" Text="Status: Not set up" TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>

                        <!-- Setup steps: shown without a key, or after "Replace key" -->
                        <StackPanel x:Name="ApiKeySetupPanel" Margin="0,8,0,0" Spacing="8">
                            <TextBlock Text="1. Create an Admin key on the Claude Platform. Only organization admins can create Admin keys."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="ApiKeyCreateButton" Content="Create an Admin key" Padding="10,4"
                                    Click="OnCreateAdminKeyClicked"
                                    ToolTipService.ToolTip="Opens platform.claude.com/settings/admin-keys in your browser"/>
                            <TextBlock Text="2. Paste the key here, then save it."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox x:Name="ApiKeyPasswordBox" PasswordRevealMode="Hidden" PlaceholderText="sk-ant-..."
                                         AutomationProperties.Name="Anthropic Admin key" MaxWidth="360" HorizontalAlignment="Stretch"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ApiKeySaveButton" Content="Save key" Padding="10,4" Click="OnSaveKeyClicked"
                                        ToolTipService.ToolTip="Checks the key with Anthropic, then saves it"/>
                                <Button x:Name="ApiKeyCancelReplaceButton" Content="Cancel" Padding="10,4" Visibility="Collapsed"
                                        Click="OnCancelReplaceKeyClicked"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- With a key set -->
                        <StackPanel x:Name="ApiKeyManagePanel" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button x:Name="ApiKeyReplaceButton" Content="Replace key" Padding="10,4" Click="OnReplaceKeyClicked"/>
                            <Button x:Name="ApiKeyRemoveButton" Content="Remove key" Padding="10,4">
                                <Button.Flyout>
                                    <Flyout x:Name="ApiKeyRemoveFlyout">
                                        <StackPanel Spacing="12" MaxWidth="280">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Remove the Admin key from this PC? The dashboard stops showing API spend. The key stays active at Anthropic until you delete it on the Claude Platform."/>
                                            <Button Content="Remove key" Padding="10,4" Click="OnRemoveKeyConfirmed"
                                                    AutomationProperties.Name="Confirm remove key"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- The outcome of the last key action; "Save anyway" only after Anthropic could not be reached -->
                        <TextBlock x:Name="ApiKeyMessageText" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="ApiKeySaveAnywayButton" Content="Save anyway" Padding="10,4" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="OnSaveKeyAnywayClicked"
                                ToolTipService.ToolTip="Saves the key without checking it with Anthropic"/>
                        <TextBlock Text="Key changes apply right away. The budget and renewal day below are saved with Save."
                                   Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Monthly budget (USD)" TextWrapping="Wrap"/>
                                <TextBlock Text="Your monthly API allowance in US dollars"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <NumberBox Grid.Column="1" x:Name="ApiCreditsMonthlyBox" AutomationProperties.Name="Monthly budget (USD)"
                                       Minimum="1" Maximum="100000" SmallChange="10" LargeChange="50"
                                       SpinButtonPlacementMode="Compact" Width="110" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Renewal day" TextWrapping="Wrap"/>
                                <TextBlock Text="The day of the month your credits renew, in UTC (1 to 28)"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <NumberBox Grid.Column="1" x:Name="ApiCreditsCycleDayBox" AutomationProperties.Name="Renewal day"
                                       Minimum="1" Maximum="28" SmallChange="1" LargeChange="7"
                                       SpinButtonPlacementMode="Compact" Width="110" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Sign-ins Section -->
                <TextBlock
                    Text="Sign-ins"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,20,0,8"/>

                <!-- Sign-ins Card: the button sits under the state, the window is only ~350 DIP wide on a 150% display -->
                <Grid
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Text="Each provider's own app keeps its sign-in; this app only reads it"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,12"/>

                        <ItemsControl x:Name="SignInsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SignInRow">
                                    <Grid Margin="0,2" Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider Icon -->
                                        <Viewbox
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="0,2,12,0"
                                            VerticalAlignment="Top">
                                            <PathIcon Data="{x:Bind Icon}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Viewbox>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}"/>
                                            <TextBlock
                                                Text="{x:Bind StateText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"/>
                                            <Button
                                                Content="Sign in"
                                                Tag="{x:Bind ProviderId}"
                                                Visibility="{x:Bind SignInVisibility}"
                                                AutomationProperties.Name="{x:Bind SignInName}"
                                                Click="OnSignInClicked"
                                                Margin="0,8,0,0"
                                                Padding="10,4"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="Behavior"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,20,0,8"/>

                <!-- Refresh Interval Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Refresh interval" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="How often to fetch new usage data"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Column="1"
                        x:Name="RefreshIntervalComboBox" AutomationProperties.Name="Refresh interval"
                        Width="150"
                        VerticalAlignment="Center">
                        <ComboBoxItem Content="1 minute" Tag="60"/>
                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                    </ComboBox>
                </Grid>

                <!-- Refresh Faster While In Use Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Refresh faster while a tool is in use" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Check a provider every 2 minutes while you use its tool on this PC"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="ActivityRefreshToggle" AutomationProperties.Name="Refresh faster while a tool is in use"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Start with Windows Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Run at startup" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Start AgentsWinBar when you sign in to Windows"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="StartWithWindowsToggle" AutomationProperties.Name="Run at startup"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Start Minimized Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Start minimized" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Minimize to system tray on startup"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="StartMinimizedToggle" AutomationProperties.Name="Start minimized"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Always-on Overlay Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Always-on overlay" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Keep a small usage readout on screen (drag to move, right-click for options)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="AlwaysOnOverlayToggle" AutomationProperties.Name="Always-on overlay"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Taskbar Display Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Taskbar display" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Show a compact usage strip on the taskbar"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="TaskbarDisplayToggle" AutomationProperties.Name="Taskbar display"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>

                    <!-- Position: under the toggle row, laid out like the theme card (label, then the dropdown below it),
                         as the window is too narrow for the dropdown beside its label. Item text stays short ("Right
                         end"): a longer one is cut off in the closed dropdown at 150% scale -->

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Position" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock
                                Text="Automatic uses the right end, next to the system tray, when Start is at the left end of the taskbar"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox
                            x:Name="TaskbarPositionComboBox" AutomationProperties.Name="Taskbar display position"
                            MinWidth="220"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="Automatic" Tag="auto"/>
                            <ComboBoxItem Content="Left end" Tag="left"/>
                            <ComboBoxItem Content="Right end" Tag="right"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Usage Alerts Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Usage alerts" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Notify me when usage is far ahead of pace, nearly out, or at the limit (once per window)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                        <Button
                            Content="Send test notification"
                            Click="OnTestAlertClicked"
                            Margin="0,8,0,0"
                            Padding="10,4"/>
                        <TextBlock
                            x:Name="TestAlertStatus"
                            Visibility="Collapsed"
                            Margin="0,6,0,0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="AlertsToggle" AutomationProperties.Name="Usage alerts"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Developer Mode Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Developer mode" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Use sample data instead of live usage (for testing)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="DeveloperModeToggle" AutomationProperties.Name="Developer mode"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Save/Cancel buttons -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="100"
                    Click="OnCancelClicked"/>
                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    MinWidth="100"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
