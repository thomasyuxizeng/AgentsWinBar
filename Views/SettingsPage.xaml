<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexBarWin.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBarWin.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" Padding="20,8,20,20">
            <StackPanel Spacing="4" MaxWidth="600">

                <InfoBar x:Name="SaveErrorBar" IsOpen="False" Severity="Error"
                         Title="Couldn't save settings"
                         Message="Check that the settings folder is writable, then try again."/>

                <!-- Appearance Section -->
                <TextBlock
                    Text="Appearance"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,12,0,8"/>

                <!-- Theme Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- The dropdown sits under its label instead of beside it: the window is only ~350 DIP wide on a 150% display, so a
                         side-by-side layout either clipped "Use system setting" (fixed 150) or squeezed the label to nothing (wide). -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="App theme" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Select which app theme to display"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Row="1"
                        x:Name="ThemeComboBox" AutomationProperties.Name="App theme"
                        MinWidth="220"
                        HorizontalAlignment="Left">
                        <ComboBoxItem Content="Use system setting" Tag="0"/>
                        <ComboBoxItem Content="Light" Tag="1"/>
                        <ComboBoxItem Content="Dark" Tag="2"/>
                    </ComboBox>
                </Grid>

                <!-- Reset animation Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Reset animation" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            x:Name="ResetAnimationDescriptionText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Row="1"
                        x:Name="ResetAnimationComboBox" AutomationProperties.Name="Reset animation"
                        MinWidth="220"
                        HorizontalAlignment="Left"/>
                </Grid>

                <!-- Providers Section -->
                <TextBlock
                    Text="Providers"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,20,0,8"/>

                <!-- Providers Card -->
                <Grid
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Text="Choose which providers to show, whether the dashboard charts them, and their display order"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,12"/>

                        <ItemsControl x:Name="ProvidersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Provider Icon -->
                                        <Viewbox
                                            Grid.Column="0"
                                            Grid.RowSpan="2"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                            <PathIcon Data="{Binding IconPath}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Viewbox>

                                        <!-- Provider Checkbox -->
                                        <CheckBox
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Content="{Binding DisplayName}"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            MinWidth="100"/>

                                        <!-- Spacer -->
                                        <Grid Grid.Column="2"/>

                                        <!-- Graphs on the dashboard -->
                                        <CheckBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Content="Show graphs"
                                            FontSize="12"
                                            IsChecked="{Binding ShowGraphs, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Show this provider's charts below the dashboard panels"/>

                                        <!-- Move Up Button -->
                                        <Button
                                            Grid.RowSpan="2"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Move up"
                                            Padding="8,6"
                                            Margin="4,0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="Move provider up" Click="OnMoveUpClicked">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" FontSize="12"/>
                                        </Button>

                                        <!-- Move Down Button -->
                                        <Button
                                            Grid.RowSpan="2"
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Move down"
                                            Padding="8,6"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="Move provider down" Click="OnMoveDownClicked">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Behavior Section -->
                <Grid Padding="16,12" Margin="0,8,0,0" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Show cost and token totals" TextWrapping="Wrap"/>
                        <TextBlock Text="Estimates from local session logs, scanned while the flyout or dashboard is open"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="CostTotalsToggle" AutomationProperties.Name="Show cost and token totals" OnContent="" OffContent=""
                                  MinWidth="0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Claude API credit pool (spend itself is read automatically) -->
                <Grid Padding="16,12" Margin="0,8,0,0" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Monthly API budget (USD)" TextWrapping="Wrap"/>
                        <TextBlock Text="Spend is read automatically with your Anthropic Admin key."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <NumberBox Grid.Column="1" x:Name="ApiCreditsMonthlyBox" AutomationProperties.Name="Monthly API budget (USD)"
                               Minimum="1" Maximum="100000" SmallChange="10" LargeChange="50"
                               SpinButtonPlacementMode="Compact" Width="110" VerticalAlignment="Center"/>
                </Grid>

                <Grid Padding="16,12" Margin="0,8,0,0" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Credit renewal day" TextWrapping="Wrap"/>
                        <TextBlock Text="Day of the month credits renew (UTC)."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <NumberBox Grid.Column="1" x:Name="ApiCreditsCycleDayBox" AutomationProperties.Name="Credit renewal day"
                               Minimum="1" Maximum="28" SmallChange="1" LargeChange="7"
                               SpinButtonPlacementMode="Compact" Width="110" VerticalAlignment="Center"/>
                </Grid>

                <!-- Sign-ins Section -->
                <TextBlock
                    Text="Sign-ins"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,20,0,8"/>

                <!-- Sign-ins Card: the button sits under the state, the window is only ~350 DIP wide on a 150% display -->
                <Grid
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Text="Each provider's own app keeps its sign-in; this app only reads it"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,12"/>

                        <ItemsControl x:Name="SignInsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SignInRow">
                                    <Grid Margin="0,2" Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider Icon -->
                                        <Viewbox
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="0,2,12,0"
                                            VerticalAlignment="Top">
                                            <PathIcon Data="{x:Bind Icon}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Viewbox>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}"/>
                                            <TextBlock
                                                Text="{x:Bind StateText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"/>
                                            <Button
                                                Content="Sign in"
                                                Tag="{x:Bind ProviderId}"
                                                Visibility="{x:Bind SignInVisibility}"
                                                AutomationProperties.Name="{x:Bind SignInName}"
                                                Click="OnSignInClicked"
                                                Margin="0,8,0,0"
                                                Padding="10,4"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="Behavior"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,20,0,8"/>

                <!-- Refresh Interval Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Refresh interval" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="How often to fetch new usage data"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Column="1"
                        x:Name="RefreshIntervalComboBox" AutomationProperties.Name="Refresh interval"
                        Width="150"
                        VerticalAlignment="Center">
                        <ComboBoxItem Content="1 minute" Tag="60"/>
                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                    </ComboBox>
                </Grid>

                <!-- Start with Windows Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Run at startup" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Start CodexBarWin when you sign in to Windows"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="StartWithWindowsToggle" AutomationProperties.Name="Run at startup"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Start Minimized Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Start minimized" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Minimize to system tray on startup"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="StartMinimizedToggle" AutomationProperties.Name="Start minimized"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Always-on Overlay Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Always-on overlay" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Keep a small usage readout on screen (drag to move, right-click for options)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="AlwaysOnOverlayToggle" AutomationProperties.Name="Always-on overlay"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Taskbar Display Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Taskbar display" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Show a compact usage strip on the taskbar, bottom-left corner"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="TaskbarDisplayToggle" AutomationProperties.Name="Taskbar display"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Usage Alerts Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Usage alerts" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Notify me when usage is far ahead of pace, nearly out, or at the limit (once per window)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                        <Button
                            Content="Send test notification"
                            Click="OnTestAlertClicked"
                            Margin="0,8,0,0"
                            Padding="10,4"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="AlertsToggle" AutomationProperties.Name="Usage alerts"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Developer Mode Card -->
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Developer mode" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock
                            Text="Use sample data instead of CodexBar CLI (for testing)"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        x:Name="DeveloperModeToggle" AutomationProperties.Name="Developer mode"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        Margin="0,-4,0,-4"
                        VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Save/Cancel buttons -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="100"
                    Click="OnCancelClicked"/>
                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    MinWidth="100"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
