<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AgentsWinBar.Views.ProviderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentsWinBar.Views"
    xmlns:controls="using:AgentsWinBar.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: Back button + Provider name + Icon -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Back button -->
            <Button
                Grid.Column="0"
                x:Name="BackButton"
                ToolTipService.ToolTip="Back"
                Click="OnBackClicked"
                Padding="8"
                Margin="0,0,8,0"
                Background="Transparent"
                BorderBrush="Transparent">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="14"/>
            </Button>

            <!-- Provider Icon -->
            <Viewbox
                Grid.Column="1"
                Width="16"
                Height="16"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
                <PathIcon x:Name="ProviderIcon" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Viewbox>

            <!-- Provider Name -->
            <TextBlock
                Grid.Column="2"
                x:Name="ProviderName"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">

                <!-- Signed out: the provider's CLI needs a new login; the bars below are last-known and dimmed -->
                <InfoBar x:Name="SignedOutBanner" IsOpen="False" IsClosable="False" Visibility="Collapsed"
                         Severity="Error" Title="Signed out" AutomationProperties.Name="Signed out">
                    <!-- InfoBar's compact action size (24 high) keeps the title row's height; the hint starts below the button -->
                    <InfoBar.ActionButton>
                        <Button x:Name="SignInButton" Content="Sign in" Click="OnSignInClicked" MinHeight="24" Padding="8,0,8,1"/>
                    </InfoBar.ActionButton>
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                        <TextBlock x:Name="SignedOutHint" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </InfoBar>

                <TextBlock x:Name="ServiceStatusStaleAlone" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Border x:Name="ServiceStatusBanner" Visibility="Collapsed" Padding="12"
                        BorderThickness="1" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Provider service status" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ServiceStatusDescription" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ServiceStatusIncidentTitle" TextWrapping="Wrap" FontWeight="Medium" Visibility="Collapsed"/>
                        <TextBlock x:Name="ServiceStatusIncidentBody" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <TextBlock x:Name="ServiceStatusIncidentAge" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="ServiceStatusStale" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <HyperlinkButton x:Name="ServiceStatusLink" Content="Open status page" Padding="0"
                                         HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Session Usage -->
                <Grid
                    x:Name="SessionSection"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBlock x:Name="SessionSectionTitle"
                        Text="Session Usage"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        />
                        <Border x:Name="SessionEarlyChip" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed"
                                Background="{x:Bind local:DashboardFormat.EarlyBrush()}">
                            <TextBlock Text="RESET EARLY" FontSize="9" FontWeight="Bold" Foreground="#CC000000"/>
                        </Border>
                    </StackPanel>

                    <controls:UsageMeter
                        Grid.Row="1"
                        x:Name="SessionMeter"
                        Height="10"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            x:Name="SessionPercentText"
                            TextWrapping="NoWrap"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="SessionResetText"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="SessionEarlyDetail" Margin="0,4,0,0" Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </Grid>

                <!-- Weekly Usage -->
                <controls:BurndownChart x:Name="SessionHistory" Margin="12,0"/>

                <Grid
                    x:Name="WeeklySection"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBlock x:Name="WeeklySectionTitle"
                        Text="Weekly Usage"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        />
                        <Border x:Name="WeeklyEarlyChip" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed"
                                Background="{x:Bind local:DashboardFormat.EarlyBrush()}">
                            <TextBlock Text="RESET EARLY" FontSize="9" FontWeight="Bold" Foreground="#CC000000"/>
                        </Border>
                    </StackPanel>

                    <controls:UsageMeter
                        Grid.Row="1"
                        x:Name="WeeklyMeter"
                        Height="10"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            x:Name="WeeklyPercentText"
                            TextWrapping="NoWrap"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="WeeklyResetText"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="WeeklyEarlyDetail" Margin="0,4,0,0" Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </Grid>

                <!-- Tertiary Usage (e.g., Sonnet Weekly for Claude) -->
                <controls:BurndownChart x:Name="WeeklyHistory" Margin="12,0"/>

                <Grid
                    x:Name="TertiarySection"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBlock x:Name="TertiarySectionTitle"
                        Text="Tertiary Usage"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        />
                        <Border x:Name="TertiaryEarlyChip" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed"
                                Background="{x:Bind local:DashboardFormat.EarlyBrush()}">
                            <TextBlock Text="RESET EARLY" FontSize="9" FontWeight="Bold" Foreground="#CC000000"/>
                        </Border>
                    </StackPanel>

                    <controls:UsageMeter
                        Grid.Row="1"
                        x:Name="TertiaryMeter"
                        Height="10"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            x:Name="TertiaryPercentText"
                            TextWrapping="NoWrap"
                            Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="TertiaryResetText"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="TertiaryEarlyDetail" Margin="0,4,0,0" Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </Grid>

                <!-- Extra windows (e.g. Antigravity's Claude and GPT quota): detail page only -->
                <controls:BurndownChart x:Name="TertiaryHistory" Margin="12,0" Visibility="Collapsed"/>

                <ItemsControl x:Name="ExtraWindowsList" IsTabStop="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ExtraWindowRow">
                            <Grid
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold"/>
                                    <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{x:Bind EarlyVisibility}"
                                            Background="{x:Bind local:DashboardFormat.EarlyBrush()}">
                                        <TextBlock Text="RESET EARLY" FontSize="9" FontWeight="Bold" Foreground="#CC000000"/>
                                    </Border>
                                </StackPanel>

                                <controls:BurndownChart Grid.Row="4" Margin="0,12,0,0"
                                                        Series="{x:Bind History}" Accent="{x:Bind Accent}"/>

                                <controls:UsageMeter
                                    Grid.Row="1"
                                    Height="10"
                                    Accent="{x:Bind Accent}"
                                    Percent="{x:Bind Percent}"
                                    TimePercent="{x:Bind TimePercent}"
                                    PaceText="{x:Bind PaceText}"
                                    ResetFromPercent="{x:Bind ResetFromUsedPercent}"
                                    ResetDetectedAtUtc="{x:Bind ResetDetectedAtUtc}"/>

                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind PercentText}"
                                        TextWrapping="NoWrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind ResetText}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Grid.Row="3" Margin="0,4,0,0" Text="{x:Bind EarlyDetail}"
                                           Visibility="{x:Bind EarlyVisibility}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="CostSection" Visibility="Collapsed" Padding="12" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Estimated cost and tokens" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CostTotalText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CostTodayText" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="CostDaysSelector" SelectedIndex="2" SelectionChanged="OnCostDaysChanged">
                            <ComboBoxItem Content="Last 7 days" Tag="7"/>
                            <ComboBoxItem Content="Last 14 days" Tag="14"/>
                            <ComboBoxItem Content="Last 30 days" Tag="30"/>
                        </ComboBox>
                        <controls:DailyCostChart x:Name="CostChart"/>
                        <TextBlock Text="Top models · last 30 days" FontWeight="SemiBold" FontSize="11"/>
                        <ItemsControl x:Name="CostModelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CostNote" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Grid
                    x:Name="DetailsSection"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Details"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Margin="0,0,0,2"/>

                        <!-- Plan -->
                        <Grid x:Name="PlanRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Plan"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="PlanText"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>

                        <!-- Status -->
                        <Grid x:Name="StatusRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Source"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="StatusText"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>

                        <!-- Last fetched -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Last fetched"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="FetchedAtText"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Error Section -->
                <Grid
                    x:Name="ErrorSection"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with copy button -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE7BA;"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock
                                Text="Error Log"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="6,4"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Copy to clipboard"
                            Click="OnCopyError">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Shown when the usage bars above are last-known data -->
                    <TextBlock
                        Grid.Row="1"
                        x:Name="LastKnownDataText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Visibility="Collapsed"/>

                    <!-- Error text (read-only TextBox) -->
                    <TextBox
                        Grid.Row="2"
                        x:Name="ErrorTextBox"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MaxHeight="150"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
